{
    "name": "react-reactive-forms",
    "version": "0.1.0",
    "description": "A reactive forms library for React inspired by Angular Reactive Forms",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
        "prepublishOnly": "npm run build",
        "prepare": "husky install"
    },
    "keywords": [
        "react",
        "forms",
        "reactive",
        "validation",
        "form-validation",
        "typescript",
        "hooks"
    ],
    "author": "Your Name",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yourusername/react-reactive-forms.git"
    },
    "bugs": {
        "url": "https://github.com/yourusername/react-reactive-forms/issues"
    },
    "homepage": "https://github.com/yourusername/react-reactive-forms#readme",
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.2",
        "@types/estree": "^1.0.8",
        "@types/json-schema": "^7.0.15",
        "@types/node": "^20.10.6",
        "@types/react": "^18.2.46",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "@vitest/coverage-v8": "^1.1.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "husky": "^8.0.3",
        "jsdom": "^23.0.1",
        "prettier": "^3.1.1",
        "react": "^19.2.4",
        "tsup": "^8.0.1",
        "typescript": "^5.3.3",
        "vitest": "^1.1.0"
    },
    "engines": {
        "node": ">=16.0.0"
    }
}
